# Configuration for docker-compose.yml. `make up` copies this file to .env on first run;
# .env is git-ignored. The values below are safe defaults for a local development stack.
#
# Running on a public domain instead of localhost, change at least:
#   SITE_ADDRESS, CADDY_TLS, MB_PUBLIC_BASE_URL, MB_ENVIRONMENT=production,
#   POSTGRES_PASSWORD, the MB_SMTP_* settings of a real mail relay and the MB_IMPRINT_*
#   provider details.

# --- Database ---------------------------------------------------------------------------
POSTGRES_DB=modellbahn
POSTGRES_USER=modellbahn
# Embedded in the connection URL, so use URL-safe characters only (letters, digits, - _ . ~).
# Generate a real one with: openssl rand -hex 24
# The development value matches the backend's default MB_DATABASE_URL, so a backend started
# with `uv run` on the host talks to the `make dev-db` database without further settings.
POSTGRES_PASSWORD=modellbahn
# Host port for local tools and `make dev-db`; bound to 127.0.0.1 only.
POSTGRES_HOST_PORT=5432

# --- Backend: api, worker, migrate (prefix MB_) -----------------------------------------
# development | production (production refuses to start with MB_COOKIE_SECURE=false).
MB_ENVIRONMENT=development
# Base URL for links in e-mails (verification, password reset). Must match SITE_ADDRESS.
MB_PUBLIC_BASE_URL=https://localhost
# Defaults deliver every e-mail to Mailpit (http://localhost:8025).
MB_SMTP_HOST=mailpit
MB_SMTP_PORT=1025
MB_SMTP_STARTTLS=false
# Sender of every e-mail; its display name is the shop name in subjects and texts.
# Keep it the same as NEXT_PUBLIC_SHOP_NAME.
MB_SMTP_FROM="adp-Modelle <noreply@modellbahn.local>"

# Optional: uncomment to override the backend default shown. An empty value is not "unset",
# so leave unused lines commented out.
# MB_COOKIE_SECURE=true
# MB_SMTP_USERNAME=
# MB_SMTP_PASSWORD=
# Argon2id parameters; defaults are those of argon2-cffi (RFC 9106, low-memory profile).
# MB_ARGON2_TIME_COST=3
# MB_ARGON2_MEMORY_COST=65536
# MB_ARGON2_PARALLELISM=4
# Outbox worker: fallback polling interval in seconds (it is woken by NOTIFY anyway)
# and the number of attempts before an event is marked dead.
# MB_OUTBOX_POLL_SECONDS=5
# MB_OUTBOX_MAX_ATTEMPTS=10
# Requests per client address to login, registration, verification and password reset
# within the window (seconds); further ones get 429. 0 switches the limit off.
# MB_AUTH_RATE_LIMIT=30
# MB_AUTH_RATE_WINDOW_SECONDS=600
# The same for placing orders and paying for them.
# MB_CHECKOUT_RATE_LIMIT=30
# MB_CHECKOUT_RATE_WINDOW_SECONDS=600
# The same for signing up to the fair news (each sign-up sends a mail).
# MB_FAIR_NEWS_RATE_LIMIT=10
# MB_FAIR_NEWS_RATE_WINDOW_SECONDS=600
# MB_LOG_LEVEL=INFO

# --- Object storage (Garage, S3 API) ----------------------------------------------------
# Development values only. For a real server generate new ones:
#   GARAGE_RPC_SECRET:        openssl rand -hex 32
#   GARAGE_ADMIN_TOKEN:       openssl rand -base64 32
#   MB_S3_ACCESS_KEY_ID:      GK followed by 24 hex digits, e.g. "GK$(openssl rand -hex 12)"
#   MB_S3_SECRET_ACCESS_KEY:  openssl rand -hex 32
# `make up` runs init-storage, which imports exactly this key; after changing the key on an
# existing installation, delete the old one with `garage key delete` inside the container.
GARAGE_RPC_SECRET=3d261150278b319721d9ef0c334c6991f4b811a0b821b825d3e7535ada585e4f
GARAGE_ADMIN_TOKEN=LKiiCvfknvtAGPWwWz0Y9oBsi7VhYKBbMoGjTTt-gfE
MB_S3_ACCESS_KEY_ID=GKba9ff40c8a82b4ef09ebaf72
MB_S3_SECRET_ACCESS_KEY=7f38e28c0803bd1400af0bea7463f260950bc644c40e3bdc2e19579fde50dbbf
# Optional: where browsers load the rendered images from. Default: /medien on this site,
# which Caddy serves from the public bucket. A CDN in front would go here.
# MB_MEDIA_PUBLIC_BASE_URL=/medien

# --- Imprint (§ 5 DDG) ------------------------------------------------------------------
# The provider details on /impressum and below every e-mail. Production refuses to start
# until company, owner, street, postal code, city and e-mail are set. Placeholders here;
# the real values belong only in .env.
MB_IMPRINT_COMPANY="Muster-Modelle"
MB_IMPRINT_OWNER="Max Mustermann"
MB_IMPRINT_STREET="Musterstraße 1"
MB_IMPRINT_POSTAL_CODE=12345
MB_IMPRINT_CITY=Musterstadt
MB_IMPRINT_EMAIL=info@example.com
# Optional:
# MB_IMPRINT_PHONE="0123 456789"
# MB_IMPRINT_COUNTRY=Deutschland
# VAT identification number, only if there is one: DE followed by 9 digits.
# MB_IMPRINT_VAT_ID=DE123456789

# --- eBay -------------------------------------------------------------------------------
# off: no eBay. test: the built-in test marketplace, eBay's flow without eBay (nothing
# leaves the server; the Stellwerk can sell there as a buyer). sandbox / production:
# eBay's APIs with the keys of the developer account (developer.ebay.com, "Application
# Keys" and "User Tokens" -> RuName, whose accepted URL is
# https://<site>/api/v1/admin/marketplace/ebay/callback). Production allows off or
# production only, and needs its own MB_EBAY_TOKEN_KEY.
MB_EBAY_MODE=test
# MB_EBAY_CLIENT_ID=
# MB_EBAY_CLIENT_SECRET=
# MB_EBAY_RU_NAME=
# Encrypts eBay's tokens in the database. Generate one with:
#   python3 -c "import base64, secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# MB_EBAY_TOKEN_KEY=

# --- Frontend ---------------------------------------------------------------------------
# Shop name shown in the UI. Inlined at build time; `make up` rebuilds the image.
NEXT_PUBLIC_SHOP_NAME=adp-Modelle

# --- Caddy (HTTPS reverse proxy) --------------------------------------------------------
# Host name Caddy serves. "localhost" gets a certificate from Caddy's internal CA.
SITE_ADDRESS=localhost
# "internal" = certificate from Caddy's own CA (browsers warn until it is trusted).
# For a public domain set your e-mail address instead; Caddy then uses Let's Encrypt (ACME).
CADDY_TLS=internal

# --- Mailpit (development mail catcher) -------------------------------------------------
# Host ports, bound to 127.0.0.1 only.
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
