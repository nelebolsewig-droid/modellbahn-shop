{
  "components": {
    "schemas": {
      "AccountDeletionIn": {
        "additionalProperties": false,
        "properties": {
          "password": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "password"
        ],
        "title": "AccountDeletionIn",
        "type": "object"
      },
      "AccountOut": {
        "description": "A customer's own account.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "email_verified": {
            "title": "Email Verified",
            "type": "boolean"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "display_name",
          "email_verified",
          "created_at"
        ],
        "title": "AccountOut",
        "type": "object"
      },
      "DisplayNameIn": {
        "additionalProperties": false,
        "properties": {
          "display_name": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          }
        },
        "required": [
          "display_name"
        ],
        "title": "DisplayNameIn",
        "type": "object"
      },
      "EmailIn": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "EmailIn",
        "type": "object"
      },
      "HealthOut": {
        "description": "Answer of the health probes.",
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthOut",
        "type": "object"
      },
      "LoginIn": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginIn",
        "type": "object"
      },
      "PasswordChangeIn": {
        "additionalProperties": false,
        "properties": {
          "current_password": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Current Password",
            "type": "string"
          },
          "new_password": {
            "maxLength": 256,
            "minLength": 10,
            "title": "New Password",
            "type": "string"
          }
        },
        "required": [
          "current_password",
          "new_password"
        ],
        "title": "PasswordChangeIn",
        "type": "object"
      },
      "PasswordResetConfirmIn": {
        "additionalProperties": false,
        "properties": {
          "new_password": {
            "maxLength": 256,
            "minLength": 10,
            "title": "New Password",
            "type": "string"
          },
          "token": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token",
          "new_password"
        ],
        "title": "PasswordResetConfirmIn",
        "type": "object"
      },
      "Problem": {
        "description": "OpenAPI schema of an RFC 9457 problem response.",
        "properties": {
          "code": {
            "examples": [
              "invalid_credentials"
            ],
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "status": {
            "examples": [
              401
            ],
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "examples": [
              "Unauthorized"
            ],
            "title": "Title",
            "type": "string"
          },
          "type": {
            "examples": [
              "/problems/invalid-credentials"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code"
        ],
        "title": "Problem",
        "type": "object"
      },
      "ProblemFieldError": {
        "description": "OpenAPI schema of one entry in ``errors``.",
        "properties": {
          "code": {
            "examples": [
              "invalid"
            ],
            "title": "Code",
            "type": "string"
          },
          "field": {
            "examples": [
              "email"
            ],
            "title": "Field",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "code",
          "message"
        ],
        "title": "ProblemFieldError",
        "type": "object"
      },
      "RealtimeEventData": {
        "description": "The JSON in the ``data:`` field of every SSE message.",
        "properties": {
          "data": {
            "additionalProperties": true,
            "title": "Data",
            "type": "object"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          },
          "truncated": {
            "title": "Truncated",
            "type": "boolean"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "occurred_at",
          "data",
          "truncated"
        ],
        "title": "RealtimeEventData",
        "type": "object"
      },
      "RegistrationAcceptedOut": {
        "description": "Same answer whether or not the address already had an account.",
        "properties": {
          "status": {
            "const": "pending_verification",
            "default": "pending_verification",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "RegistrationAcceptedOut",
        "type": "object"
      },
      "RegistrationIn": {
        "additionalProperties": false,
        "properties": {
          "display_name": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 256,
            "minLength": 10,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password",
          "display_name"
        ],
        "title": "RegistrationIn",
        "type": "object"
      },
      "RequestAcceptedOut": {
        "description": "Same answer whether or not an e-mail is sent.",
        "properties": {
          "status": {
            "const": "accepted",
            "default": "accepted",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "RequestAcceptedOut",
        "type": "object"
      },
      "StaffOut": {
        "description": "A staff member's own account.",
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/StaffRole"
          }
        },
        "required": [
          "id",
          "email",
          "display_name",
          "role"
        ],
        "title": "StaffOut",
        "type": "object"
      },
      "StaffRole": {
        "enum": [
          "owner",
          "staff",
          "packer"
        ],
        "title": "StaffRole",
        "type": "string"
      },
      "TokenIn": {
        "additionalProperties": false,
        "properties": {
          "token": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "title": "TokenIn",
        "type": "object"
      },
      "ValidationProblem": {
        "description": "OpenAPI schema of a 422 problem response.",
        "properties": {
          "code": {
            "examples": [
              "validation_failed"
            ],
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ProblemFieldError"
            },
            "title": "Errors",
            "type": "array"
          },
          "status": {
            "examples": [
              422
            ],
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "examples": [
              "Unprocessable Content"
            ],
            "title": "Title",
            "type": "string"
          },
          "type": {
            "examples": [
              "/problems/validation-failed"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "errors"
        ],
        "title": "ValidationProblem",
        "type": "object"
      }
    },
    "securitySchemes": {
      "customerSession": {
        "description": "Session cookie of the shop (set by loginCustomer and verifyCustomerEmail).",
        "in": "cookie",
        "name": "mb_session",
        "type": "apiKey"
      },
      "staffSession": {
        "description": "Session cookie of the admin area (set by staffLogin).",
        "in": "cookie",
        "name": "mb_admin",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "API of the Modellbahn-Shop.\n\n* Errors are RFC 9457 problem details (`application/problem+json`) with a stable `code`.\n* State-changing requests (POST, PUT, PATCH, DELETE) under `/api/` must send the header\n  `X-Modellbahn-Client: web` and, if they have a body, `Content-Type: application/json`.\n* Customers and staff authenticate with separate session cookies (`mb_session`, `mb_admin`).\n",
    "title": "Modellbahn-Shop API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/admin/auth/me": {
      "get": {
        "operationId": "getStaffAccount",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaffOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized. Problem codes: `not_authenticated`."
          }
        },
        "security": [
          {
            "staffSession": []
          }
        ],
        "summary": "The logged-in staff member's account and role",
        "tags": [
          "admin-auth"
        ]
      }
    },
    "/api/v1/admin/auth/password": {
      "post": {
        "description": "Ends every other admin session of the account; the worker mails a notice.",
        "operationId": "changeStaffPassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordChangeIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request. Problem codes: `invalid_password`."
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized. Problem codes: `not_authenticated`."
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden. Problem codes: `csrf_header_missing`."
          },
          "415": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unsupported Media Type. Problem codes: `unsupported_media_type`."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            },
            "description": "Unprocessable Content. Problem codes: `validation_failed`."
          }
        },
        "security": [
          {
            "staffSession": []
          }
        ],
        "summary": "Change the password",
        "tags": [
          "admin-auth"
        ]
      }
    },
    "/api/v1/admin/auth/session": {
      "delete": {
        "description": "Ends the session and clears the cookie. Idempotent.",
        "operationId": "staffLogout",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden. Problem codes: `csrf_header_missing`."
          },
          "415": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unsupported Media Type. Problem codes: `unsupported_media_type`."
          }
        },
        "security": [
          {
            "staffSession": []
          }
        ],
        "summary": "Log out of the admin area",
        "tags": [
          "admin-auth"
        ]
      },
      "post": {
        "description": "Sets the ``mb_admin`` cookie. Locked accounts answer like wrong credentials.",
        "operationId": "staffLogin",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaffOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized. Problem codes: `invalid_credentials`."
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden. Problem codes: `csrf_header_missing`."
          },
          "415": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unsupported Media Type. Problem codes: `unsupported_media_type`."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            },
            "description": "Unprocessable Content. Problem codes: `validation_failed`."
          }
        },
        "summary": "Log in to the admin area",
        "tags": [
          "admin-auth"
        ]
      }
    },
    "/api/v1/admin/events": {
      "get": {
        "description": "Server-Sent Events. Each message has `id` (event id, UUIDv7), `event` (event type) and `data` (JSON, see RealtimeEventData). A comment line is sent every 15 seconds as a heartbeat. Reconnecting with `Last-Event-ID` replays up to 100 missed events.",
        "operationId": "streamAdminEvents",
        "parameters": [
          {
            "in": "header",
            "name": "Last-Event-ID",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Last-Event-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "itemSchema": {
                  "properties": {
                    "data": {
                      "contentMediaType": "application/json",
                      "contentSchema": {
                        "$ref": "#/components/schemas/RealtimeEventData"
                      },
                      "type": "string"
                    },
                    "event": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "retry": {
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized. Problem codes: `not_authenticated`."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            },
            "description": "Unprocessable Content. Problem codes: `validation_failed`."
          }
        },
        "security": [
          {
            "staffSession": []
          }
        ],
        "summary": "Live stream of events for the 'staff' audience",
        "tags": [
          "admin-realtime"
        ]
      }
    },
    "/api/v1/store/account/email-verification": {
      "post": {
        "description": "Redeem the token from the verification mail; sets the ``mb_session`` cookie.",
        "operationId": "verifyCustomerEmail",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request. Problem codes: `invalid_token`."
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden. Problem codes: `csrf_header_missing`."
          },
          "415": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unsupported Media Type. Problem codes: `unsupported_media_type`."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            },
            "description": "Unprocessable Content. Problem codes: `validation_failed`."
          }
        },
        "summary": "Verify the e-mail address and log in",
        "tags": [
          "store-account"
        ]
      }
    },
    "/api/v1/store/account/email-verification/resend": {
      "post": {
        "description": "Always 202; only unverified customer accounts get a mail.",
        "operationId": "resendVerificationEmail",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestAcceptedOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden. Problem codes: `csrf_header_missing`."
          },
          "415": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unsupported Media Type. Problem codes: `unsupported_media_type`."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            },
            "description": "Unprocessable Content. Problem codes: `validation_failed`."
          }
        },
        "summary": "Send the verification mail again",
        "tags": [
          "store-account"
        ]
      }
    },
    "/api/v1/store/account/me": {
      "get": {
        "operationId": "getCustomerAccount",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized. Problem codes: `not_authenticated`."
          }
        },
        "security": [
          {
            "customerSession": []
          }
        ],
        "summary": "The logged-in customer's account",
        "tags": [
          "store-account"
        ]
      },
      "patch": {
        "operationId": "updateCustomerAccount",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DisplayNameIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized. Problem codes: `not_authenticated`."
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden. Problem codes: `csrf_header_missing`."
          },
          "415": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unsupported Media Type. Problem codes: `unsupported_media_type`."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            },
            "description": "Unprocessable Content. Problem codes: `validation_failed`."
          }
        },
        "security": [
          {
            "customerSession": []
          }
        ],
        "summary": "Change the display name",
        "tags": [
          "store-account"
        ]
