<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Pfade anpassen: wo uv liegt (which uv) und wo Skript und drucker.toml liegen. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>de.adp-modelle.drucker-bruecke</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/uv</string>
    <string>run</string>
    <string>drucker_bruecke.py</string>
    <string>drucker.toml</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/johann/drucker-bruecke</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/drucker-bruecke.log</string>
  <key>StandardErrorPath</key><string>/tmp/drucker-bruecke.log</string>
</dict>
</plist>
